//1
class Solution {
public:
    TreeNode* searchBST(TreeNode* root, int val) {
         if (!root) return nullptr;          // base case: empty tree
        if (root->val == val) return root;  // found the node
        if (val < root->val) return searchBST(root->left, val);  // search left
        return searchBST(root->right, val); // search right
    
    }
};

//2
class Solution {
public:
    bool isValidBST(TreeNode* root) {
        return helper(root, LONG_MIN, LONG_MAX);
    }
private:
    bool helper(TreeNode* node, long minVal, long maxVal) {
        if (!node) return true;
        if (node->val <= minVal || node->val >= maxVal) return false;
        return helper(node->left, minVal, node->val) &&
               helper(node->right, node->val, maxVal);
    }
};

//3
class Solution {
public:
    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {
        while (root) {
            if (p->val < root->val && q->val < root->val) {
                root = root->left;   // both in left subtree
            } else if (p->val > root->val && q->val > root->val) {
                root = root->right;  // both in right subtree
            } else {
                return root;         // split or equal → LCA
            }
        }
        return nullptr;
    }
};

