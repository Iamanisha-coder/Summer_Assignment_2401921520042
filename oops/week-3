abstract class Compartment {
    public abstract String notice();
}

class FirstClass extends Compartment {
    public String notice() {
        return "First Class: Enjoy your comfortable journey.";
    }
}

class Ladies extends Compartment {
    public String notice() {
        return "Ladies Compartment: Reserved for ladies.";
    }
}

class General extends Compartment {
    public String notice() {
        return "General Compartment: Please cooperate with others.";
    }
}

class Luggage extends Compartment {
    public String notice() {
        return "Luggage Compartment: Goods only.";
    }
}

public class TestCompartment {
    public static void main(String[] args) {

        Compartment[] c = new Compartment[10];

        for (int i = 0; i < 10; i++) {
            int r = (int)(Math.random() * 4);

            if (r == 0)
                c[i] = new FirstClass();
            else if (r == 1)
                c[i] = new Ladies();
            else if (r == 2)
                c[i] = new General();
            else
                c[i] = new Luggage();
        }

        System.out.println("Compartments and Notices:");

        for (int i = 0; i < 10; i++) {
            System.out.println((i + 1) + ". " + c[i].notice());
        }
    }
}
